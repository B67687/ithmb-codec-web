# Copy to .env.local for local runs. Never commit real values.

# Cloudflare Pages direct upload (docs/RUNBOOK.md). The token needs Pages:Edit;
# the project name is the Pages project in the dashboard (no default is stored).
CLOUDFLARE_API_TOKEN=
CF_PROJECT=

# Legacy release-branch publish flow only; the current deploy does not use these.
CF_ACCOUNT_ID=
